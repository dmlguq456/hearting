{
  "schema_version": 1,
  "harness": "claude",
  "parent_completion": {
    "carrier": "claude-parent-runtime",
    "reason": "claude-async-rewake-resume",
    "parent_proof": "runtime-hook",
    "without_carrier": "poll"
  },
  "session_identity": {
    "env": [
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_SESSION_ID"
    ],
    "process_proof": "session-registry",
    "herdr_session_id": "verified",
    "sub_session_root": "shared-id"
  },
  "access": {
    "enforcement": "tool-permission",
    "means": {
      "read": "--add-dir with an Edit deny rule per root",
      "write": "--add-dir",
      "network": "unenforced"
    }
  }
}
