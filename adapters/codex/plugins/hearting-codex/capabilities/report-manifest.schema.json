{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities/report-manifest.schema.json",
  "title": "Portable report media manifest",
  "type": "object",
  "required": ["schema_version", "outputs", "summary_stats", "house_parameters", "media", "visual_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "outputs": {
      "type": "object",
      "required": ["markdown", "html"],
      "properties": {
        "markdown": {"$ref": "#/$defs/file"},
        "html": {"$ref": "#/$defs/file"}
      },
      "additionalProperties": false
    },
    "summary_stats": {"type": "object", "minProperties": 1},
    "house_parameters": {
      "type": "object",
      "required": ["sample_rate_hz", "frequency_band_hz"],
      "properties": {
        "sample_rate_hz": {"const": 48000},
        "frequency_band_hz": {"type": "array", "prefixItems": [{"const": 0}, {"const": 24000}], "items": false}
      }
    },
    "media": {"type": "array", "minItems": 1},
    "visual_evidence": {"type": "array", "minItems": 1},
    "bundle": {
      "type": "object",
      "required": ["title", "primary_representation_id", "representations"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "primary_representation_id": {"type": "string"},
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "format", "roles"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "format": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*$"},
              "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["canonical", "summary", "interactive", "navigation"]}},
              "output": {"enum": ["markdown", "html"]},
              "file": {"$ref": "#/$defs/file"},
              "section_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "oneOf": [{"required": ["output"]}, {"required": ["file"]}],
            "additionalProperties": false
          }
        },
        "equivalence_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "representation_ids", "section_order"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "representation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
              "section_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
