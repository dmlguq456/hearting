# Credentials & secrets
.credentials.json

# Session data (per-machine, ephemeral)
history.jsonl
sessions/
.spec-grounding/
.core-grounding/
session-env/
shell-snapshots/
paste-cache/
file-history/
ide/
debug/
cache/
downloads/
backups/
telemetry/
todos/
tasks/
# root-anchored(/plans/): 런타임 plan-mode 디렉토리만 — 비앵커 plans/ 가 .agent_reports/plans/(커밋 자산, CONVENTIONS §5 agent-home 예외)까지 오폭하던 것 정정 (2026-07-10)
/plans/
plugins/
!adapters/codex/plugins/
!adapters/codex/plugins/**
!adapters/codex/plugin-marketplace/
!adapters/codex/plugin-marketplace/**
!adapters/codex/.agents/
!adapters/codex/.agents/**
!adapters/opencode/plugins/
!adapters/opencode/plugins/**
!adapters/claude/plugin-marketplace/
!adapters/claude/plugin-marketplace/**

# Python bytecode caches (per-machine, ephemeral)
__pycache__/
*.py[cod]

# Project-scoped memory (per-project, not shared)
projects/

# Unified memory store → 전용 repo(claude-memory)로 분리 (2026-06-15, DB-SoT 전환).
# memory.db(로컬 SoT)·dump.jsonl(전용 repo가 추적)·파생물 전부 config repo 에선 무시.
# root-anchored(/memory/): 코드 디렉토리 tools/memory/ 까지 무차별 매칭하지 않게 (2026-06-16).
/memory

# NFS temp files
.nfs*

# MCP runtime cache (per-machine, ephemeral)
mcp-needs-auth-cache.json

# Cleanup timestamp (per-machine, ephemeral)
.last-cleanup

# CLI auto-update result + sync log + usage stats (per-machine, ephemeral — churn noise)
.last-update-result.json
.sync.log
stats-cache.json

# 일회성 진단 스냅샷 (로컬 참조용 — 공유 repo 미포함)
SKILL_AUDIT_*.md

# analyze-user 내부 — 전체 로컬 전용 (public repo 미포함).
# clone 해서 "바로 쓰는" 데는 DB store (memory.db / dump.jsonl) 만 필요. (구 `user_profile/0*.md`·`README` 는 DB `type=profile` 레코드·`MEMORY.md §7.6` 매트릭스로 이전 — sub-agent 는 `mem profile <stem>` 로 Read.)
# _internal 은 프로필 제작·갱신용 산출물 (raw 분석 run·개인 원본 PDF·버전 스냅샷·metadata) — 개인정보 다수.
user_profile/_internal/
# assets 는 사용자 실제 연구 figure (pptx 추출 SVG 54장·원본 anchor PNG·primitives, ~42M, 일부 미공개) — 로컬 전용.
# pptx(ref_user_profile/figure_ppt/)에서 pdftocairo 로 언제든 재생성. clone 엔 불필요.
user_profile/assets/
.cache/
loops/*.log
adapters/*/loops/*.log
loops/drill/results/
loops/drill/metrics.csv
.statusline-last.json
.statusline-last-out.txt
.dispatch/
/.agent-workspace/

# Runtime daemon/job state (per-machine, generated by local background runner)
daemon.log
daemon/
jobs/

# Drill/oncall transient run log
loops/drill/.oncall-run.log
# v2.0 (2026-07-31): artifact history and runtime grounding state are
# local-only — the former agent-home commit exception is retired
# (CONVENTIONS §5.1). Pre-2.0 history stays in git history.
/.agent_reports/
/.claude_reports/
/.capability-grounding/
/.route-grounding/

# loop 일시 hold 토글 (per-machine, 만료일 담긴 런타임 플래그)
loops/.hold

# 분사 headless가 worktree에 남기는 nested agent-memory cruft 차단
/.claude/

# worklog-board — submodule 일시 제거(2026-06-16), standalone repo 로 운영
/worklog-board/
/worklog-board-wt/

# 렌더 검증 스크린샷 (QA 산출물, 로컬 전용)
docs/.visual-harness/
