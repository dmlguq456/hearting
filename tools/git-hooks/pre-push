#!/bin/sh
# Refuse a push whose generated core projections are stale.
#
# CI runs `python3 tools/generate.py --check` and fails the whole run when a
# projection drifted. That signal arrives minutes after the push, on a commit
# that is already public and already tagged by the release workflow. This runs
# the same check locally, before the push leaves the machine.
#
# Enable:  git config core.hooksPath tools/git-hooks
# Bypass:  git push --no-verify
#
# Deliberately not a pre-commit hook: the full check takes ~17s, which is real
# friction per commit but negligible once per push.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/tools/generate.py" ] || exit 0

# Git exports repository-local variables to push hooks.  A generator that
# invokes a repo-relative helper with `git -C` must discover the worktree from
# that helper's path, not inherit the hook's gitdir as an implicit worktree.
git_local_env=$(git rev-parse --local-env-vars 2>/dev/null || :)
if [ -n "$git_local_env" ]; then
    # Intentional field splitting: rev-parse emits one variable name per line.
    # shellcheck disable=SC2086
    unset $git_local_env
fi

command -v python3 >/dev/null 2>&1 || {
    echo "pre-push: python3 not found; skipping the generated-projection check" >&2
    exit 0
}

if python3 "$root/tools/generate.py" --check; then
    exit 0
fi

cat >&2 <<'MSG'

pre-push: generated core projections are stale — CI would fail this push.

  fix:    python3 tools/generate.py && git add -u && git commit --amend --no-edit
  bypass: git push --no-verify
MSG
exit 1
